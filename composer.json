{
    "name": "alfatraining/alfaview-php-sdk",
    "description": "PHP client for the alfaview API v2",
    "keywords": [
        "php",
        "sdk",
        "rest",
        "api"
    ],
    "homepage": "https://github.com/alfatraining/alfaview-php-sdk",
    "license": "MIT License",
    "authors": [
        {
            "name": "alfatraining",
            "homepage": "https://alfaview.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": { "Alfaview\\Client\\" : "lib/" }
    },
    "autoload-dev": {
        "psr-4": { "Alfaview\\Client\\Test\\" : "test/" }
    }
}
